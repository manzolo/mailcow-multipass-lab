# Network Configuration for Mail Server Lab
# Subnet: 10.4.26.0/24

# Network settings
NETWORK_SUBNET="10.4.26.0/24"
NETWORK_GATEWAY="10.4.26.1"
NETWORK_BRIDGE="mpqemubr0"

# DNS Server
DNS_SERVER_IP="10.4.26.10"
DNS_SERVER_NAME="dns-server"
DNS_SERVER_HOSTNAME="ns1.lab"

# Mail Servers
MARS_IP="10.4.26.11"
MARS_NAME="mars"
MARS_HOSTNAME="mail.mars.lab"
MARS_DOMAIN="mars.lab"

VENUS_IP="10.4.26.12"
VENUS_NAME="venus"
VENUS_HOSTNAME="mail.venus.lab"
VENUS_DOMAIN="venus.lab"

JUPITER_IP="10.4.26.13"
JUPITER_NAME="jupiter"
JUPITER_HOSTNAME="mail.jupiter.lab"
JUPITER_DOMAIN="jupiter.lab"

# Resource allocation
DNS_CPU="1"
DNS_RAM="512M"
DNS_DISK="5G"

MAIL_CPU="2"
MAIL_RAM="2G"
MAIL_DISK="10G"
