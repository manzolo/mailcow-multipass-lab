# Domain Configuration for Mail Server Lab

# List of all domains
DOMAINS=("mars.lab" "venus.lab" "jupiter.lab")

# Domain to IP mapping
declare -A DOMAIN_IPS
DOMAIN_IPS["mars.lab"]="10.4.26.11"
DOMAIN_IPS["venus.lab"]="10.4.26.12"
DOMAIN_IPS["jupiter.lab"]="10.4.26.13"

# Domain to VM name mapping
declare -A DOMAIN_VMS
DOMAIN_VMS["mars.lab"]="mars"
DOMAIN_VMS["venus.lab"]="venus"
DOMAIN_VMS["jupiter.lab"]="jupiter"

# Mail hostnames
declare -A MAIL_HOSTNAMES
MAIL_HOSTNAMES["mars.lab"]="mail.mars.lab"
MAIL_HOSTNAMES["venus.lab"]="mail.venus.lab"
MAIL_HOSTNAMES["jupiter.lab"]="mail.jupiter.lab"
