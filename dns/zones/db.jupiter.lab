$TTL    604800
@       IN      SOA     ns1.lab. admin.jupiter.lab. (
                              2024010101         ; Serial (YYYYMMDDNN)
                              604800             ; Refresh
                              86400              ; Retry
                              2419200            ; Expire
                              604800 )           ; Negative Cache TTL

; Name servers
@       IN      NS      ns1.lab.

; A records
@       IN      A       10.4.26.13
mail    IN      A       10.4.26.13
autoconfig      IN      A       10.4.26.13
autodiscover    IN      A       10.4.26.13

; MX record
@       IN      MX      10      mail.jupiter.lab.

; SPF record
@       IN      TXT     "v=spf1 mx a ip4:10.4.26.13 ~all"

; DKIM record (placeholder - will be updated after Mailcow setup)
dkim._domainkey IN      TXT     "v=DKIM1; k=rsa; p=PLACEHOLDER"

; DMARC record
_dmarc  IN      TXT     "v=DMARC1; p=none; rua=mailto:postmaster@jupiter.lab"

; SRV records for autodiscovery
_submission._tcp        IN      SRV     0 1 587 mail.jupiter.lab.
_imap._tcp              IN      SRV     0 1 143 mail.jupiter.lab.
_imaps._tcp             IN      SRV     0 1 993 mail.jupiter.lab.
_pop3._tcp              IN      SRV     0 1 110 mail.jupiter.lab.
_pop3s._tcp             IN      SRV     0 1 995 mail.jupiter.lab.

; Autoconfig/Autodiscover for email clients
_autodiscover._tcp      IN      SRV     0 1 443 mail.jupiter.lab.
